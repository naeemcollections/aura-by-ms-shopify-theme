<div class="page-width search-page">
  <p class="eyebrow">Search</p>
  <h1>Find your aura</h1>
  <form action="{{ routes.search_url }}" method="get">
    <input type="hidden" name="type" value="product">
    <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Oud, rose, chronograph…">
    <button class="btn" type="submit">Search</button>
  </form>
  {% if search.performed %}
    <div class="product-grid product-grid--4" style="margin-top:2rem">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}
      {% else %}
        <p class="empty">Nothing matched that search.</p>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
