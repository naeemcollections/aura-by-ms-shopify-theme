{% assign col = section.settings.collection %}
{% if col == blank and section.settings.collection_handle != blank %}
  {% assign col = collections[section.settings.collection_handle] %}
{% endif %}
<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if col != blank %}
        <a class="section-link" href="{{ col.url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
    <div class="product-grid product-grid--4">
      {% if col != blank %}
        {% for product in col.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% else %}
          <p class="empty">Add products to the {{ col.title }} collection in Shopify admin.</p>
        {% endfor %}
      {% else %}
        <p class="empty">Create a collection with handle “{{ section.settings.collection_handle }}”, or pick one in the theme editor.</p>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The house edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured perfumes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "collection_handle", "label": "Collection handle (fallback)", "default": "perfumes" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
