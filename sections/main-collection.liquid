<section class="collection-hero">
  {% if collection.image %}<img src="{{ collection.image | image_url: width: 2000 }}" alt="{{ collection.title | escape }}">{% endif %}
  <div class="collection-hero-shade"></div>
  <div class="collection-hero-inner">
    <p class="eyebrow">The collection</p>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<p>{{ collection.description | strip_html }}</p>{% endif %}
  </div>
</section>
<div class="page-width" style="padding-bottom:5rem">
  {% paginate collection.products by 24 %}
    <div class="product-grid product-grid--4">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p class="empty">Add products to this collection in Shopify admin.</p>
      {% endfor %}
    </div>
  {% endpaginate %}
</div>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
