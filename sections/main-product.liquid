{% assign current = product.selected_or_first_available_variant %}
<div class="page-width">
  <nav class="crumbs"><a href="{{ routes.root_url }}">Home</a> / {{ product.title }}</nav>
  <div class="product">
    <div class="gallery">
      <div class="gallery-main">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | escape }}">
        {% endif %}
      </div>
    </div>
    <div class="product-info" data-product-form>
      <p class="eyebrow">{{ product.type }}</p>
      <h1>{{ product.title }}</h1>
      <p class="product-price">{{ current.price | money }}</p>
      <div class="product-desc rte">{{ product.description }}</div>
      {% unless product.has_only_default_variant %}
        <div class="option-row">
          <div class="swatches">
            {% for variant in product.variants %}
              <button type="button" class="swatch {% if variant.id == current.id %}is-active{% endif %}" data-swatch="{{ variant.id }}">{{ variant.title }}<span>{{ variant.price | money }}</span></button>
            {% endfor %}
          </div>
        </div>
      {% endunless %}
      <select class="visually-hidden" data-variant-select name="id">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% if variant.id == current.id %}selected{% endif %}>{{ variant.title }}</option>
        {% endfor %}
      </select>
      <div class="buy-box">
        <button class="btn btn--full" type="button" data-add-to-cart="{{ current.id }}">Add to cart</button>
        <button class="btn btn--outline btn--full" type="button" data-buy-now="{{ current.id }}">Buy now</button>
      </div>
      <details class="acc" open><summary>Shipping</summary><p>Complimentary shipping on orders over $250.</p></details>
      <details class="acc"><summary>Returns</summary><p>Unopened perfumes and unworn watches may be returned within 30 days. Opened eaux de parfum are final sale.</p></details>
    </div>
  </div>
</div>
{% schema %}
{ "name": "Product", "settings": [] }
{% endschema %}
