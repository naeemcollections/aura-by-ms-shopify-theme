<div class="page-width section">
  <p class="eyebrow">The house</p>
  <h1>Collections</h1>
  <div class="split" style="margin-top:3rem">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a class="split-panel" href="{{ collection.url }}">
          {% if collection.image %}<img src="{{ collection.image | image_url: width: 1400 }}" alt="">{% endif %}
          <div class="split-shade"></div>
          <div class="split-copy"><h2>{{ collection.title }}</h2><span class="split-cta">Shop</span></div>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</div>
{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
