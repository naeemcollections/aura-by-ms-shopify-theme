<section class="house-band">
  <div class="house-band-grid">
    <div class="house-band-media">
      {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1400 }}" alt="">{% endif %}
    </div>
    <div class="house-band-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="gold-rule"></div>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}
        <a class="btn btn--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "House story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The house" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One flacon. A thousand midnights." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Aura by MS is a private house of fragrance and time." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read the story" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/pages/about" }
  ]
}
{% endschema %}
