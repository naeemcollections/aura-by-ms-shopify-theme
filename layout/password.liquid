<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Outfit:wght@400;500&display=swap">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-prose" style="min-height:100svh;display:flex;flex-direction:column;justify-content:center;text-align:center">
      <p class="logo-ms">MS</p>
      <h1 style="margin-top:1rem">Aura by MS</h1>
      <p style="margin-top:1rem;color:var(--muted)">The house opens soon.</p>
      {% form 'storefront_password', class: 'newsletter' %}
        <input class="field" type="password" name="password" placeholder="Password">
        <button class="btn" type="submit">Enter</button>
      {% endform %}
    </main>
  </body>
</html>
